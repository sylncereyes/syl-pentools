{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "*qa-auth*": "deny",
      "*.env*": "deny",
      "jq *": "allow",
      "mkdir *": "allow",
      "bash qa/login_b.sh": "allow",
      "bash qa/api_b.sh*": "allow",
      "pgrep *": "allow",
      "bash qa/smoke.sh": "allow",
      "curl *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bash qa/api.sh*": "allow",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git rm*": "deny",
      "qa/.tools-venv/bin/*": "allow",
      "docker run *": "allow",
      "docker ps*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add qa*": "allow",
      "git commit *": "allow",
      "psql *": "ask",
      "redis-cli *": "ask",
      "nmap *": "deny",
      "sqlmap *": "deny",
      "hydra *": "deny",
      "nikto *": "deny",
      "masscan *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "docker stop *": "deny",
      "docker rm *": "deny",
      "docker compose *": "deny",
      "./start.sh*": "deny",
      "date*": "allow",
      "echo *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "awk *": "allow",
      "find *": "allow",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "bash qa/login.sh": "allow",
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  }
}
